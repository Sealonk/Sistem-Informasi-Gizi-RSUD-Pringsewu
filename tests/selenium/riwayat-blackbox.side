          "target": "xpath=//*[contains(text(),'Tersimpan Otomatis')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-c5",
          "comment": "Verifikasi badge Petugas tampil",
          "command": "assertElementPresent",
          "target": "xpath=//span[contains(text(),'Petugas Gizi')]",
          "targets": [],
          "value": ""
