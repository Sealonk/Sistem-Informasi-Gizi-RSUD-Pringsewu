        {
          "command": "open",
          "target": "/riwayat",
          "value": ""
        },
        {
          "command": "assertElementPresent",
          "target": "xpath=//h1[text()='Riwayat Perhitungan']",
          "value": ""
        },
        {
          "command": "assertElementPresent",
          "target": "xpath=//button[contains(text(), 'Kembali ke Portal')]",
          "value": ""
