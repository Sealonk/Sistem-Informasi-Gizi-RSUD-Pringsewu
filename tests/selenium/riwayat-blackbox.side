{
  "id": "riwayat-blackbox-suite",
  "version": "2.0",
  "name": "Blackbox Testing - Riwayat Perhitungan Gizi",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "tc-rw-001",
      "name": "TC-RW-001 - Inisialisasi & Tampilan Antarmuka Halaman Riwayat",
      "commands": [
        {
          "id": "tc01-p1",
          "comment": "Buka root untuk inject token",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p2",
          "comment": "Suntikkan token JWT valid",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZF91c2VyIjoyLCJ1c2VybmFtZSI6ImdpemkwMSIsIm5hbWFfbGVuZ2thcCI6IlBldHVnYXMgR2l6aSAxIiwicm9sZSI6InBldHVnYXNfZ2l6aSIsImlhdCI6MTc4MjY1MjAxNywiZXhwIjoxNzgyNjk1MjE3fQ.5pkr0yTNAeC73cK_hLa95-ZD9Zv9swXSCkJ9WahhI0Q');",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p2b",
          "comment": "Suntikkan user object ke localStorage",
          "command": "executeScript",
          "target": "window.localStorage.setItem('user', JSON.stringify({id_user:2,username:\"gizi01\",nama_lengkap:\"Petugas Gizi 1\",role:\"petugas_gizi\"}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p3",
          "comment": "Buka halaman Riwayat",
          "command": "open",
          "target": "/riwayat",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p4",
          "comment": "Tunggu judul Riwayat Perhitungan tampil",
          "command": "waitForElementPresent",
          "target": "xpath=//h1[text()='Riwayat Perhitungan']",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "tc01-c1",
          "comment": "Verifikasi breadcrumb tampil",
          "command": "assertElementPresent",
          "target": "xpath=//div[contains(text(),'Beranda')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-c2",
          "comment": "Verifikasi deskripsi halaman tampil",
          "command": "assertElementPresent",
          "target": "xpath=//p[contains(text(),'Daftar hasil perhitungan kebutuhan gizi pasien')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-c3",
