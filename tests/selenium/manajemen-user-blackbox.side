{
  "id": "manajemen-user-blackbox-suite",
  "version": "2.0",
  "name": "Blackbox Testing - Manajemen User",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "tc-mu-001",
      "name": "TC-MU-001 - Inisialisasi & Tampilan Antarmuka Halaman Manajemen User (Role Admin)",
      "commands": [
        {
          "id": "tc01-p1",
          "comment": "Buka root untuk inject token",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p2",
          "comment": "Suntikkan token JWT admin",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZF91c2VyIjoxLCJ1c2VybmFtZSI6ImFkbWluIiwibmFtYV9sZW5na2FwIjoiQWRtaW5pc3RyYXRvciIsInJvbGUiOiJhZG1pbiIsImlhdCI6MTc4NTMzNjYyNSwiZXhwIjo0OTQxMDk2NjI1fQ.-ga-6EEX0e6lY0mp7NVwid_zVOCSXa7I5NGTLd6f00A');",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p2b",
          "comment": "Suntikkan user admin ke localStorage",
          "command": "executeScript",
          "target": "window.localStorage.setItem('user', JSON.stringify({\"id_user\":1,\"username\":\"admin\",\"nama_lengkap\":\"Administrator\",\"role\":\"admin\"}));",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p3",
          "comment": "Buka halaman Manajemen User",
          "command": "open",
          "target": "/manajemen-user",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-p4",
          "comment": "Tunggu judul Manajemen User tampil",
          "command": "waitForElementPresent",
          "target": "xpath=//h1[text()='Manajemen User']",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "tc01-c1",
          "comment": "Verifikasi badge Administrator tampil",
          "command": "assertElementPresent",
          "target": "xpath=//p[text()='Administrator']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc01-c2",
          "comment": "Verifikasi badge login Administrator tampil",
          "command": "waitForElementPresent",
          "target": "xpath=//*[contains(.,'Login sebagai Administrator')]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "tc01-c3",
          "comment": "Verifikasi summary panel Kelola akses petugas gizi tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Kelola akses petugas gizi']",
          "targets": [],
          "value": ""
        }
      ]
    },
    {
