          "comment": "Matikan penyakit lain yang aktif (DM, CKD, CHF, Stroke, dll)",
          "command": "executeScript",
          "target": "const buttons = Array.from(document.querySelectorAll(\"button\")); const others = [\"Diabetes Mellitus\", \"CKD\", \"CHF\", \"Stroke\", \"Mifflin\", \"Critical Ill\"]; others.forEach(name => { const btn = buttons.find(b => b.textContent.includes(name)); if (btn && btn.className.includes(\"border-emerald-500\")) { btn.click(); } });",
