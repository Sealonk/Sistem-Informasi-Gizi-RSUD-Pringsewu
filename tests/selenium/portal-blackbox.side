    {
      "id": "f9e4e6b1-a75d-4f24-9b5f-55df27d11894",
      "name": "TC-PT-005 - Mengubah Slide Tips Edukasi Klinis Hari Ini",
      "commands": [
        {
          "id": "33f01f11-3eb1-4682-8bc1-12c8230b561c",
          "comment": "Suntikkan token",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'dummy-token-for-testing');",
          "targets": [],
          "value": ""
        },
        {
          "id": "33f01f22-4eb2-4783-9bc2-23c8230b562d",
          "comment": "Buka portal",
          "command": "open",
          "target": "/portal",
          "targets": [],
          "value": ""
        },
        {
          "id": "33f01f33-5eb3-4884-ac32-33c8230b563e",
          "comment": "Klik dot kedua pada widget tips",
          "command": "click",
          "target": "xpath=(//div[contains(@class, 'lg:col-span-2')]//button)[2]",
          "targets": [
            [
              "xpath=(//div[contains(@class, 'lg:col-span-2')]//button)[2]",
              "xpath:finder"
            ]
          ],
          "value": ""
        },
        {
          "id": "33f01f44-6eb4-4985-bc43-43c8230b564f",
          "comment": "Verifikasi teks tips berubah sesuai dengan index 1 (Tips DM)",
          "command": "assertText",
          "target": "xpath=//div[contains(@class, 'lg:col-span-2')]//p",
          "targets": [
            [
              "xpath=//div[contains(@class, 'lg:col-span-2')]//p",
              "xpath:finder"
            ]
          ],
          "value": "\"Bagi pasien Diabetes Melitus, penambahan kalori kehamilan disesuaikan dengan Trimester (TM1: +300 kkal, TM3: +500 kkal).\""
        }
      ]
    },
