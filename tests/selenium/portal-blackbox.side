      "name": "TC-PT-001 - Menampilkan Halaman Portal dengan Elemen Utama",
      "commands": [
        {
          "id": "e01a1820-21db-46a4-8452-f47285bf81a1",
          "comment": "Suntikkan token dummy agar lolos ProtectedRoute",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'dummy-token-for-testing');",
          "targets": [],
          "value": ""
        },
        {
          "id": "673f8510-1cde-4934-8ab3-87a151b72e51",
          "comment": "Buka halaman portal",
          "command": "open",
          "target": "/portal",
          "targets": [],
          "value": ""
        },
        {
          "id": "97e68bf2-da64-44df-be91-7db138f5f653",
          "comment": "Verifikasi badge Akses Portal Aktif",
