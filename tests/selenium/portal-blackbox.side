          "command": "executeScript",
          "target": "return window.localStorage.getItem('token') === null;",
          "targets": [],
          "value": "isTokenDeleted"
        },
        {
          "id": "55f01f88-eeb8-4989-bc47-83c8230b5653",
          "comment": "Verifikasi token null",
          "command": "assert",
          "target": "${isTokenDeleted}",
          "targets": [],
          "value": "true"
        }
      ]
