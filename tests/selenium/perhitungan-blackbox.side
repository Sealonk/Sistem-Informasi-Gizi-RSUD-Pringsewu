    {
      "id": "aa01f001-0001-4001-8001-000000000001",
      "name": "TC-PH-001 - Menampilkan Halaman Pilih Pasien",
      "commands": [
        {
          "id": "aa01c001-0001-4001-8001-100000000001",
          "comment": "Suntikkan token dummy agar lolos ProtectedRoute",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'dummy-token-for-testing');",
          "targets": [],
          "value": ""
        },
        {
          "id": "aa01c001-0001-4001-8001-100000000002",
          "comment": "Buka halaman pilih pasien",
          "command": "open",
          "target": "/perhitungan",
          "targets": [],
          "value": ""
        },
        {
          "id": "aa01c001-0001-4001-8001-100000000003",
          "comment": "Verifikasi judul Perhitungan Gizi tampil",
          "command": "assertText",
          "target": "css=h1",
          "targets": [["css=h1", "css:finder"]],
          "value": "Perhitungan Gizi"
