{
  "id": "ringkasan-sistem-blackbox-suite",
  "version": "2.0",
  "name": "Blackbox Testing - Ringkasan Sistem",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "tc-rs-001",
      "name": "TC-RS-001 - Inisialisasi & Tampilan Antarmuka Halaman Ringkasan Sistem",
      "commands": [
        {
          "id": "tc-rs-001-prep-1",
          "comment": "Buka halaman root untuk inject token",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-prep-2",
          "comment": "Suntikkan token JWT valid",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZF91c2VyIjoyLCJ1c2VybmFtZSI6ImdpemkwMSIsIm5hbWFfbGVuZ2thcCI6IlBldHVnYXMgR2l6aSAxIiwicm9sZSI6InBldHVnYXNfZ2l6aSIsImlhdCI6MTc4MjY2NjkzNywiZXhwIjoxODE0MjAyOTM3fQ.sO3IY8IipaRqyxQuYQYTIwlFhI82qiOJ-jfRcLFHNB8');",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-prep-3",
          "comment": "Buka halaman Ringkasan Sistem",
          "command": "open",
          "target": "/ringkasan-sistem",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-prep-4",
          "comment": "Tunggu halaman selesai loading (judul Ringkasan Sistem muncul)",
          "command": "waitForElementPresent",
          "target": "xpath=//h1[text()='Ringkasan Sistem']",
          "targets": [],
          "value": "15000"
        },
        {
          "id": "tc-rs-001-c1",
          "comment": "Verifikasi breadcrumb tampil",
          "command": "assertElementPresent",
          "target": "xpath=//p[contains(text(),'Beranda')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c2",
          "comment": "Verifikasi badge Live Dashboard tampil",
          "command": "assertElementPresent",
          "target": "xpath=//*[contains(text(),'Live Dashboard')]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c3",
          "comment": "Verifikasi bagian Aksi Cepat Pelayanan tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Aksi Cepat Pelayanan']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c4",
          "comment": "Verifikasi bagian Ringkasan Status Gizi tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Ringkasan Status Gizi']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c5",
          "comment": "Verifikasi bagian Rata-rata Hasil Perhitungan tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Rata-rata Hasil Perhitungan']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c6",
          "comment": "Verifikasi bagian Distribusi Penyakit tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Distribusi Penyakit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c7",
          "comment": "Verifikasi bagian Riwayat Perhitungan Terakhir tampil",
          "command": "assertElementPresent",
          "target": "xpath=//h2[text()='Riwayat Perhitungan Terakhir']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-rs-001-c8",
          "comment": "Verifikasi tombol Kembali ke Portal tampil",
          "command": "assertElementPresent",
          "target": "xpath=//button[contains(text(),'Kembali ke Portal')]",
          "targets": [],
          "value": ""
        }
      ]
    },
