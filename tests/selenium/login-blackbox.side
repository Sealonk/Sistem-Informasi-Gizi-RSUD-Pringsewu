        {
          "id": "778af4a8-ea4f-4348-83ea-b2049b78bf32",
          "comment": "Pastikan field password tersedia",
          "command": "assertElementPresent",
          "target": "css=input[placeholder='Masukkan password']",
          "targets": [
            [
              "css=input[placeholder='Masukkan password']",
              "css:finder"
            ],
            [
              "xpath=//input[@placeholder='Masukkan password']",
              "xpath:attributes"
            ]
          ],
          "value": ""
        },
        {
          "id": "14bc0809-43d5-4d93-b8eb-a1b6e9cf1c42",
          "comment": "Pastikan tombol login tersedia",
          "command": "assertElementPresent",
