      "commands": [
        {
          "id": "tc-lg-005-01",
          "comment": "Buka halaman login",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-005-02",
          "comment": "Isi password",
          "command": "type",
          "target": "css=input[placeholder='Masukkan password']",
          "targets": [],
          "value": "password123"
        },
        {
          "id": "tc-lg-005-03a",
          "comment": "Simpan tipe field password default",
          "command": "storeAttribute",
          "target": "css=input[placeholder='Masukkan password']@type",
          "targets": [],
