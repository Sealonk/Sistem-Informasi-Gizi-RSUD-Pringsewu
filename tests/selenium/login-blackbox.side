{
  "id": "login-blackbox-suite",
  "version": "2.0",
  "name": "Blackbox Testing - Login",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "tc-lg-001",
      "name": "TC-LG-001 - Menampilkan halaman login",
      "commands": [
        {
          "id": "tc-lg-001-02",
          "comment": "Buka route login",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-001-01",
          "comment": "Bersihkan session sebelum pengujian",
          "command": "executeScript",
          "target": "window.localStorage.clear();",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-001-03",
          "comment": "Judul form login tampil",
          "command": "assertText",
          "target": "css=h2",
          "targets": [],
          "value": "Login"
        },
        {
          "id": "tc-lg-001-04",
          "comment": "Field username tersedia",
          "command": "assertElementPresent",
          "target": "css=input[placeholder='Masukkan username']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-001-05",
          "comment": "Field password tersedia",
          "command": "assertElementPresent",
          "target": "css=input[placeholder='Masukkan password']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-001-06",
          "comment": "Tombol login tersedia",
          "command": "assertElementPresent",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-001-07",
          "comment": "Link lupa password tersedia",
          "command": "assertElementPresent",
          "target": "xpath=//a[normalize-space()='Lupa password admin?']",
          "targets": [],
          "value": ""
        }
      ]
    },
    {
      "id": "tc-lg-002",
      "name": "TC-LG-002 - Login ditolak ketika username dan password kosong",
      "commands": [
        {
          "id": "tc-lg-002-02",
          "comment": "Buka halaman login",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-002-01",
          "comment": "Bersihkan session",
          "command": "executeScript",
          "target": "window.localStorage.clear();",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-002-03",
          "comment": "Klik login tanpa mengisi data",
          "command": "click",
          "target": "css=button[type='submit']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-002-04",
          "comment": "Username wajib diisi",
          "command": "assertElementPresent",
          "target": "css=input[placeholder='Masukkan username']:invalid",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-lg-002-05a",
          "comment": "Simpan pathname saat ini",
          "command": "executeScript",
          "target": "return window.location.pathname;",
          "targets": [],
          "value": "currentPath"
        },
        {
          "id": "tc-lg-002-05b",
          "comment": "Pastikan pathname sesuai",
          "command": "assert",
          "target": "currentPath",
          "targets": [],
          "value": "/"
        },
        {
          "id": "tc-lg-002-06",
          "comment": "Token tidak boleh dibuat",
          "command": "executeScript",
          "target": "return window.localStorage.getItem('token') === null;",
          "targets": [],
          "value": "isTokenEmpty"
        },
        {
          "id": "tc-lg-002-07",
          "comment": "Pastikan tidak ada token",
          "command": "assert",
          "target": "isTokenEmpty",
          "targets": [],
          "value": "true"
        }
      ]
    },
