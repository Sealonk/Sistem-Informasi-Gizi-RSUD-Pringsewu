{
  "id": "assessment-blackbox-suite",
  "version": "2.0",
  "name": "Blackbox Testing - Assessment Gizi",
  "url": "http://localhost:3000",
  "tests": [
    {
      "id": "tc-as-001",
      "name": "TC-AS-001 - Menampilkan Halaman Assessment Gizi & Identitas Pasien",
      "commands": [
        {
          "id": "tc-as-001-l-0",
          "comment": "Buka halaman login agar browser berada di domain localhost sebelum executeScript",
          "command": "open",
          "target": "/",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-as-001-l-1",
          "comment": "Suntikkan token",
          "command": "executeScript",
          "target": "window.localStorage.setItem('token', 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpZF91c2VyIjoyLCJ1c2VybmFtZSI6ImdpemkwMSIsIm5hbWFfbGVuZ2thcCI6IlBldHVnYXMgR2l6aSAxIiwicm9sZSI6InBldHVnYXNfZ2l6aSIsImlhdCI6MTc4MjY2NjkzNywiZXhwIjoxODE0MjAyOTM3fQ.sO3IY8IipaRqyxQuYQYTIwlFhI82qiOJ-jfRcLFHNB8');",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-as-001-l-2",
          "comment": "Buka halaman perhitungan",
          "command": "open",
          "target": "/perhitungan",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-as-001-l-3",
          "comment": "Tunggu tombol Pilih pasien pertama muncul",
          "command": "waitForElementPresent",
          "target": "xpath=(//button[text()='Pilih'])[1]",
          "targets": [],
          "value": "10000"
        },
        {
          "id": "tc-as-001-l-4",
          "comment": "Klik Pilih pada pasien pertama",
          "command": "click",
          "target": "xpath=(//button[text()='Pilih'])[1]",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-as-001-l-5",
          "comment": "Tunggu modal konfirmasi muncul",
          "command": "waitForElementPresent",
          "target": "xpath=//button[text()='Pilih Pasien']",
          "targets": [],
          "value": "5000"
        },
        {
          "id": "tc-as-001-l-6",
          "comment": "Klik konfirmasi 'Pilih Pasien' button di modal",
          "command": "click",
          "target": "xpath=//button[text()='Pilih Pasien']",
          "targets": [],
          "value": ""
        },
        {
          "id": "tc-as-001-l-7",
          "comment": "Tunggu elemen indikator halaman: /assessment",
          "command": "waitForElementPresent",
          "target": "xpath=//h1[text()='Assessment Gizi']",
          "targets": [],
          "value": "8000"
        },
        {
          "id": "tc-as-001-l-8",
          "comment": "Tunggu 3 detik agar pengambilan detail pasien selesai dan data ter-populate",
          "command": "pause",
          "target": "",
          "targets": [],
          "value": "3000"
        },
        {
          "id": "tc-as-001-c1",
          "comment": "Verifikasi judul halaman",
          "command": "assertText",
          "target": "css=h1",
          "targets": [],
          "value": "Assessment Gizi"
        },
        {
          "id": "tc-as-001-c2-get",
          "comment": "Ambil status readOnly Nama Pasien",
          "command": "executeScript",
          "target": "return document.querySelector(\"input[placeholder='Masukkan nama pasien']\").readOnly;",
          "targets": [],
          "value": "isNameReadOnly"
        },
        {
          "id": "tc-as-001-c2-assert",
          "comment": "Pastikan Nama Pasien readOnly",
          "command": "assert",
          "target": "isNameReadOnly",
          "targets": [],
          "value": "true"
        },
        {
          "id": "tc-as-001-c3-get",
          "comment": "Ambil status readOnly No RM",
          "command": "executeScript",
          "target": "return document.querySelector(\"input[placeholder='Masukkan nomor RM']\").readOnly;",
          "targets": [],
          "value": "isRMReadOnly"
        },
        {
          "id": "tc-as-001-c3-assert",
          "comment": "Pastikan No RM readOnly",
          "command": "assert",
          "target": "isRMReadOnly",
          "targets": [],
          "value": "true"
        },
        {
          "id": "tc-as-001-c4-get",
          "comment": "Ambil status readOnly Umur",
          "command": "executeScript",
          "target": "return document.querySelector(\"input[placeholder='Masukkan umur']\").readOnly;",
          "targets": [],
          "value": "isAgeReadOnly"
        },
        {
          "id": "tc-as-001-c4-assert",
          "comment": "Pastikan Umur readOnly",
          "command": "assert",
          "target": "isAgeReadOnly",
          "targets": [],
          "value": "true"
        }
      ]
    },
